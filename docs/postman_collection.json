{
  "info": {
    "name": "Mini Case Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "caseId", "value": "" }
  ],
  "item": [
    {
      "name": "Login Manager",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"manager@example.com\",\n  \"password\": \"Password123!\"\n}"
        }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "List Cases",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/cases?page=1&limit=10"
      }
    },
    {
      "name": "Create Case",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/cases",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientName\": \"Demo Client\",\n  \"subjectName\": \"Demo Subject\",\n  \"caseType\": \"Verification\",\n  \"dueDate\": \"2026-08-10\"\n}"
        }
      }
    },
    {
      "name": "Case Detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/cases/{{caseId}}"
      }
    },
    {
      "name": "Update Status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/cases/{{caseId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"In Progress\",\n  \"note\": \"Started work\"\n}"
        }
      }
    },
    {
      "name": "Add Comment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/cases/{{caseId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"This is a case note.\"\n}"
        }
      }
    }
  ]
}
